STEPWISE_DATABASE_URL=postgresql+psycopg://stepwise:stepwise@postgres:5432/stepwise
STEPWISE_REDIS_URL=redis://redis:6379/0
STEPWISE_ARTIFACT_ROOT=/data/artifacts
STEPWISE_MAX_UPLOAD_BYTES=5242880
STEPWISE_CORS_ORIGINS=http://localhost:5173
STEPWISE_API_URL=http://localhost:8000
STEPWISE_MAX_ATTEMPTS=3
STEPWISE_RETRY_DELAY_S=5
STEPWISE_JOB_TIMEOUT_S=300
STEPWISE_RECOVERY_GRACE_S=60

# Optional object backend; compose.minio.yml supplies local demo values.
STEPWISE_STORAGE_BACKEND=local
STEPWISE_S3_ENDPOINT_URL=http://minio:9000
STEPWISE_S3_BUCKET=stepwise
STEPWISE_S3_PREFIX=artifacts
STEPWISE_S3_REGION=us-east-1
# Set these outside version control for any non-demo environment.
# STEPWISE_S3_ACCESS_KEY=
# STEPWISE_S3_SECRET_KEY=
